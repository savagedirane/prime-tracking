# Point this at the backend's full URL for PRODUCTION builds (e.g. your Render
# URL with no trailing slash): https://prime-crest-tracking-api.onrender.com
# In local `npm run dev` you can leave this unset — Vite proxies /api to
# http://localhost:8000 for you (see vite.config.js).
VITE_API_URL=https://your-backend.example.com

# ---------------------------------------------------------------------------
# Map tiles — Leaflet itself needs NO API key; only some tile providers do.
# Defaults: CARTO dark basemap (keyless), with automatic fallback to other
# keyless providers if tiles fail. Only touch these if you want a specific
# provider or a premium style:
# ---------------------------------------------------------------------------

# Pick a preset: carto-dark | carto-light | osm | maptiler | mapbox
#VITE_MAP_PRESET=carto-dark

# Keyed providers (free tiers): set the preset above to maptiler or mapbox,
# then paste your key here (get one at maptiler.com or mapbox.com):
#VITE_MAP_API_KEY=your_key_here

# ...or go fully custom with any raster tile URL ({key} is replaced by the
# key above; Leaflet's {s}/{z}/{x}/{y}/{r} placeholders work too):
#VITE_MAP_TILE_URL=https://api.maptiler.com/maps/dark/{z}/{x}/{y}.png?key={key}
#VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; MapTiler
#VITE_MAP_SUBDOMAINS=abc
