# Full URL of the FastAPI backend for PRODUCTION builds (e.g. your Render URL
# with no trailing slash): https://prime-crest-tracking-api.onrender.com
# In local `npm run dev` you can leave this unset — Vite proxies /api to
# http://localhost:8000 for you (see vite.config.js).
VITE_API_URL=https://your-backend.example.com
