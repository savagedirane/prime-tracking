# Local dev default is SQLite; swap in a Supabase/Postgres URL for production.
# Get this from Supabase: Project Settings > Database > Connection string > URI
# (use the "Session pooler" connection for most backends; "Transaction pooler"
# if you're deploying somewhere serverless). It looks like:
#   postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./prime_tracking.db

# Secret used to sign admin JWTs. MUST be changed to a long random value
# before deploying anywhere real — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_MINUTES=480

# Comma-separated list of allowed frontend origins. "*" is fine for local dev only.
CORS_ORIGINS=http://localhost:5173
