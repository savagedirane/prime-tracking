# Local dev default is SQLite; swap in a Supabase/Postgres URL for production.
# Get this from Supabase: Project Settings > Database > Connection string > URI
# (use the "Session pooler" connection for most backends; "Transaction pooler"
# if you're deploying somewhere serverless). It looks like:
#   postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./prime_tracking.db

# Secret used to sign admin JWTs. MUST be changed to a long random value
# before deploying anywhere real — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_MINUTES=480

# Comma-separated list of allowed frontend origins. "*" is fine for local dev only.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Scalability settings (all optional — sensible defaults are used otherwise)
# ---------------------------------------------------------------------------

# Public tracking endpoint: short-TTL in-process cache (seconds). Tracking
# data only changes on admin writes, so 30-60s is safely stale-proof.
TRACK_CACHE_TTL=60
TRACK_CACHE_MAXSIZE=4096

# Per-IP rate limits (slowapi syntax) on public endpoints:
#   /api/v1/shipments/track/...  -> TRACK_RATELIMIT (blocks enumeration/scraping)
#   /api/v1/admin/login          -> AUTH_RATELIMIT  (slows credential brute force)
TRACK_RATELIMIT=30/minute
AUTH_RATELIMIT=10/minute

# Rate-limit storage. "memory://" is per-process and fine for a single
# instance; when you run multiple workers/instances, point this at Redis so
# limits are shared, e.g. redis://default:PASSWORD@host:6379/0
RATELIMIT_STORAGE_URI=memory://

# Postgres connection pool sizing (SQLite ignores these).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Phase 2: live updates, notifications, geocoding
# ---------------------------------------------------------------------------

# Webhook that receives shipment events ("milestone.added", "shipment.created")
# as JSON — point it at Make/Zapier/n8n or your own receiver to trigger
# email/WhatsApp/SMS notifications. Empty = events are only logged.
NOTIFY_WEBHOOK_URL=

# Server-side geocoding (OpenStreetMap Nominatim — free, no API key).
# Turn off for air-gapped installs/CI; failures degrade gracefully.
GEOCODE_ENABLED=true
# Nominatim's usage policy requires an identifying User-Agent — put yours.
GEOCODER_USER_AGENT=prime-crest-tracking/1.0 (your-contact@example.com)

# SSE keepalive interval in seconds (keeps proxies from idling out streams).
SSE_HEARTBEAT_SECONDS=15
